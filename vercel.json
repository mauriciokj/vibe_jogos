{
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": ""
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "functions": {
    "api/asfalto.js": {
      "maxDuration": 300,
      "regions": [
        "gru1"
      ]
    }
  }
}
