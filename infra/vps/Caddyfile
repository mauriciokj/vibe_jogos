	@home path /
	redir @home /asfalto-bruto/ 302
	import game-api
	handle {
		file_server
	}
}
flowofdevelopment.com, www.flowofdevelopment.com {
	import game-api
	# Keep the existing Firebase homepage, its assets, auth helpers and SPA routes.
	@homepage path / /index.html /assets/* /vite.svg /__/*
	handle @homepage {
		import firebase-home
	}
	@local file {path} {path}/index.html
	handle @local {
		file_server
	}
	handle {
		import firebase-home
	}
}
